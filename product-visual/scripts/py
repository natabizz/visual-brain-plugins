#!/usr/bin/env bash
# Runs a plugin script with the Python that has Pillow: the plugin's own venv when setup made one and it has
# Pillow, else python3. plugin/ensure-pillow.sh makes the same choice, so "ready" there means ready here.
V="$HOME/.visual-brain/venv/bin/python3"
if [ -x "$V" ] && "$V" -c "import PIL" 2>/dev/null; then exec "$V" "$@"; else exec python3 "$@"; fi
